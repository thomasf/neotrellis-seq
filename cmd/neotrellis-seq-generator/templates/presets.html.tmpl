<!-- BEGIN_PATTERNS_PRESETS -->
<h2 class="screen-title presets-header">Single-Voice Pattern Presets (<code>FN1 + ACCENT + STEP n</code>)</h2>
<p class="note">
  Applies preset <i>n</i> (1&ndash;16) to the active voice's current pattern.
  Patterns longer than 16 steps are printed page by page (16 steps per row).
  Velocity symbols: <strong>■</strong> Accent (127), <strong>●</strong> Normal (99), <strong>○</strong> Ghost (50), <strong>·</strong> Rest.
</p>
{{- range .PresetVoices }}

<h3>{{ .Title }}</h3>
<table class="pattern-table">
  <tr><th>Pad</th><th>Preset Name</th><th>Rhythm Pattern (16 Steps / Row)</th></tr>
  {{- range .Presets }}
  <tr>
    <td class="k"><span class="btn">STEP {{ .Pad }}</span></td>
    <td>{{ .Name }}{{ if gt .Length 16 }} <span class="len-badge">({{ .Length }} steps)</span>{{ end }}</td>
    <td class="rhythm-cell">
      {{- if eq (len .Pages) 1 }}
      <code>{{ safeHTML (index .Pages 0).RhythmHTML }}</code>
      {{- else }}
      <div class="page-rows">
        {{- range .Pages }}
        <div class="page-row"><code>{{ safeHTML .RhythmHTML }}</code></div>
        {{- end }}
      </div>
      {{- end }}
    </td>
  </tr>
  {{- end }}
</table>
{{- end }}
<!-- END_PATTERNS_PRESETS -->
