  <div class="step">REVERSE <i>STEP 5</i></div>
  <div class="step">INVERT <i>STEP 6</i></div>
  <div class="step">HUMANIZE <i>STEP 7</i></div>
  <div class="step">FILL EMPTY <i>STEP 8</i></div>
  <div class="act">DROPOUT <i>CLEAR</i></div>
  <div class="off">&mdash; <i>UNDO</i></div>
  <div class="voc0">SWAP 0 <i>VOICE 0</i></div>
  <div class="voc1">SWAP 1 <i>VOICE 1</i></div>

  <div class="step">SHUFFLE <i>STEP 9</i></div>
  <div class="step">ECHO <i>STEP 10</i></div>
  <div class="step">DECLUTTER <i>STEP 11</i></div>
  <div class="step">LIFE <i>STEP 12</i></div>
  <div class="mod">ACCENT &hellip; <i>ACCENT</i></div>
  <div class="act">REWIND <i>POS</i></div>
  <div class="voc2">SWAP 2 <i>VOICE 2</i></div>
  <div class="voc3">SWAP 3 <i>VOICE 3</i></div>

  <div class="step">SYNC LEN <i>STEP 13</i></div>
