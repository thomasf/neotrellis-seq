<div class="print-legend">
  <span class="legend-item"><span class="legend-box step-box"></span> Step</span>
  <span class="legend-item"><span class="legend-box act-box"></span> Action</span>
  <span class="legend-item"><span class="legend-box mod-box"></span> Modifier</span>
  <span class="legend-item"><span class="legend-box held-box"></span> Held (FN1 / ALL)</span>
  <span class="legend-item"><span class="legend-box voc-box"></span> Voice Swap</span>
  <span class="legend-item"><span class="legend-box off-box"></span> Unassigned</span>
</div>

<table>
  <tr><th>Pad</th><th>Action</th><th>Description</th></tr>
  <tr><td class="k">STEP 1&ndash;7, 9, 10</td><td class="act-name">Transform All</td><td>Applies corresponding single-voice transform to all unprotected voices simultaneously.</td></tr>
  <tr><td class="k">STEP 8</td><td class="act-name">Interlocking Fill</td><td>Fill empty for each voice in sequence, creating complementary interlocking parts.</td></tr>
  <tr><td class="k">STEP 11</td><td class="act-name">Declutter</td><td>Silences one randomly chosen voice on steps where two or more voices collide (never silences protected voices).</td></tr>
  <tr><td class="k">STEP 12</td><td class="act-name">Life</td><td>Advances Conway&rsquo;s Game of Life across voices on the virtual board (protected voices do not change).</td></tr>
  <tr><td class="k">ACCENT + STEP <i>n</i></td><td class="act-name">Load Kit Preset</td><td>Loads pattern preset <i>n</i> (1&ndash;16) across all unprotected voices.</td></tr>
  <tr><td class="k">STEP 13</td><td class="act-name">Sync Lengths</td><td>Sets unprotected voice loop lengths to match the selected voice&rsquo;s current pattern length.</td></tr>
  <tr><td class="k">FN2</td><td class="act-name">Odd Meters</td><td>Assigns odd lengths (5, 7, 9, 11, 13, 15) randomly across unprotected voices without altering step data.</td></tr>
  <tr><td class="k">CLEAR</td><td class="act-name">Dropout</td><td>Silences half of currently sounding unprotected voices at random (minimum 1 voice per press).</td></tr>
  <tr><td class="k">POS</td><td class="act-name">Rewind</td><td>Resets playback position of all voices to step 0 and arms them to fire on next step/clock.</td></tr>
  <tr><td class="k">VOICE <i>v</i></td><td class="act-name">Swap Pattern</td><td>Swaps selected pattern with voice <i>v</i>&rsquo;s current pattern.</td></tr>
