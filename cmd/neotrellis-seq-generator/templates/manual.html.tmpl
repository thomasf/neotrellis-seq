  <div class="off">&mdash; <i>STEP 16</i></div>
  <div class="mod held">FN1 <i>held</i></div>
  <div class="mod">ODD METERS <i>FN2</i></div>
  <div class="voc4">SWAP 4 <i>VOICE 4</i></div>
  <div class="voc5">SWAP 5 <i>VOICE 5</i></div>
</div>
