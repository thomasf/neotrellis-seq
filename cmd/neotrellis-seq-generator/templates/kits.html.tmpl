<!-- BEGIN_PATTERNS_KITS -->
<h2 class="screen-title kits-header">Full 6-Voice Kits (<code>FN1 + ALL + ACCENT + STEP n</code>)</h2>
<p class="note">
  Loads a coordinated 6-voice arrangement across the entire drum machine simultaneously.
  Multi-page and polymetric patterns are printed page by page (16 steps per row) matching the hardware page navigation.
</p>
<table class="kits-table">
  <tr><th>Pad</th><th>Kit Name &amp; Genre</th><th>6-Voice Patterns (16 Steps / Row)</th></tr>
  {{- range .Kits }}
  {{- $kit := . }}
  <tr>
    <td class="k">STEP {{ .Pad }}</td>
    <td>
      <strong>{{ .Name }}</strong><br>
      <span class="genre-tag">{{ .Genre }}</span>
    </td>
    <td class="kit-pattern">
      {{- range .Pages }}
      <div class="kit-page-block">
        {{- if gt $kit.MaxPages 1 }}
        <div class="kit-page-title">Steps {{ .StartStep }}&ndash;{{ .EndStep }}</div>
        {{- end }}
        <div class="kit-voices">
          {{- range .Voices }}
          <div class="kit-v">
            <span class="vtag v{{ .VoiceIndex }}">{{ .VoiceLabel }}</span>
            <code>{{ safeHTML .Rhythm }}</code>
          </div>
          {{- end }}
        </div>
      </div>
      {{- end }}
    </td>
  </tr>
  {{- end }}
</table>
<!-- END_PATTERNS_KITS -->
